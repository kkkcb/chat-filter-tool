# 部署凭证模板 — 复制为 .env.local 并填入真实值（.env.local 已 gitignore，永不进仓库）

# Cloudflare API 令牌（只显示一次；泄露则仪表盘撤销重发）
# 创建入口: dash.cloudflare.com/profile/api-tokens → 自定义令牌
# 权限: Account → Cloudflare Pages → 编辑（区域资源留空是正确做法）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Pages 项目名（首次部署自动创建）
PAGES_PROJECT_NAME=ice-workbench

# 线上后端地址（cloudflared tunnel / 服务器公网地址），留空 = 同源（仅本地）
# 例: VITE_API_BASE=https://ice-api.example.com
VITE_API_BASE=
